{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@fourier-video/sdk": [
        "../../fourier-sdk/src/index.ts"
      ],
      "@fourier-video/sdk/*": [
        "../../fourier-sdk/src/*.ts"
      ]
    },
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "types": [
      "bun",
      "react"
    ],
    "typeRoots": [
      "../../fourier-sdk/node_modules/@types"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}