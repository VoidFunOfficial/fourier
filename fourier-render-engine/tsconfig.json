{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@fourier-video/core": ["../fourier-core/src/index.ts"],
      "@fourier-video/core/*": ["../fourier-core/src/*.ts"],
      "@fourier-video/sdk": ["../fourier-sdk/src/index.ts"],
      "@fourier-video/sdk/*": ["../fourier-sdk/src/*.ts"]
    },
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "modules/**/*.ts",
    "benchmark/**/*.ts",
    "benchmark/**/*.tsx"
  ]
}
